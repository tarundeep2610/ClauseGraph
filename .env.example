# Copy this file to .env and fill in the blanks. See DEPLOYMENT.md for where
# each value comes from.

# Generated; same value as gpu-ocr-service/.env's GPU_OCR_SHARED_SECRET
GPU_OCR_SHARED_SECRET=

# The GPU box's existing Tailscale IP or MagicDNS hostname — this is the SAME
# host-level Tailscale login already used by the other project on that box
# (this stack runs no Tailscale client of its own). Get this by running
# `tailscale ip -4` / `tailscale status` directly on the GPU box's host (not
# inside any container). Prefer the raw IP — MagicDNS may not resolve inside
# this container even when the tailnet itself works fine.
GPU_OCR_BASE_URL=http://<gpu-tailscale-ip-or-hostname>:11610
OLLAMA_BASE_URL=http://<gpu-tailscale-ip-or-hostname>:11610/ollama

GPU_OCR_CONNECT_TIMEOUT_SECONDS=10
GPU_OCR_POLL_INTERVAL_SECONDS=3
# Client-side liveness safety net only - NOT a per-page timeout (that's
# OCR_TIMEOUT_SECONDS, enforced by the GPU service itself, further down).
# Keep this generous; it should never fire during normal operation.
GPU_OCR_CLIENT_SAFETY_TIMEOUT_SECONDS=1800

# How many pages get submitted to the GPU service at once. Keep at 1 for
# local CPU-fallback testing (see docker-compose.yml's comment); safe to
# raise on the real GPU box.
OCR_JOB_CONCURRENCY=1

# Dev-only fallback for running the unlimited engine in-process with no GPU box
OCR_LOCAL_ENGINE=false

# Step 0.4 — AuthNexus SSO. Leave these blank and set DEV_MODE=true below if you
# don't have AuthNexus admin access yet.
AUTH_AUTHORITY=
PROJECT_ID=
ORG_ID=
CLIENT_ID=

DEV_MODE=false
DEV_SECRET=

# AI-assisted document-structure indexing — read live from here only, never
# stored in the database. AI_INDEX_BASE_URL is only needed for rokkaai/
# openai_compatible (leave blank for gemini).
AI_INDEX_PROVIDER=gemini
AI_INDEX_MODEL=gemini-2.5-flash
AI_INDEX_BASE_URL=
AI_INDEX_API_KEY=
