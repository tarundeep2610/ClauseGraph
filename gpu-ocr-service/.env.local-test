# LOCAL TEST ONLY — used by docker-compose.local-test.yml to run the GPU
# service in CPU-fallback mode on a dev machine with no GPU. The prod env
# file is .env. See ../run-local-test.ps1 and DEPLOYMENT.md's "Local testing
# without a GPU" section. TS_AUTHKEY is kept here since this stack's own
# tailscale sidecar (tag:ocr-gpu) still authenticates fine locally.

# Step 0.2 — the tag:ocr-gpu auth key from the Tailscale admin console (Settings > Keys)
TS_AUTHKEY=tskey-auth-kWxYYbLVnS11CNTRL-uGQ81CkXjHGQiTrtazuoHGh7uDGMkHC8

# Same value as the repo-root .env.local-test's GPU_OCR_SHARED_SECRET
GPU_OCR_SHARED_SECRET=51732f88d782e7fa74c646a884b35a4d7aa1c43bfea919e22e6c0227c89b4e13

# Kept at 1 — CPU inference for one page already uses most of this box's
# memory/CPU; a second concurrent page risks an OOM-kill.
GPU_OCR_MAX_CONCURRENT_JOBS=1

UNLIMITED_OCR_MODEL_REVISION=main
