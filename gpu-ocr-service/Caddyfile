# Single external entry point for the whole GPU box (only one port, 11610, is
# available on this machine — so both engines share it, routed by path).
:11610 {
	# Ollama has no auth of its own, so this path is gated here.
	handle_path /ollama/* {
		@authorized header X-Gpu-Ocr-Key {$GPU_OCR_SHARED_SECRET}
		handle @authorized {
			reverse_proxy localhost:11434
		}
		handle {
			respond "Invalid or missing shared secret." 401
		}
	}
	# Everything else (/api/v1/*, /health) goes to gpu-ocr-api, which already
	# enforces the shared secret on its own /api/v1/* routes and intentionally
	# leaves /health public.
	handle {
		reverse_proxy localhost:8000
	}
}
