# Copy this file to .env and fill in the blanks. See ../DEPLOYMENT.md.

# Step 0.2 — the tag:ocr-gpu auth key from the Tailscale admin console (Settings > Keys)
TS_AUTHKEY=

# Step 0.3 — same value as the repo-root .env's GPU_OCR_SHARED_SECRET
GPU_OCR_SHARED_SECRET=

GPU_OCR_MAX_CONCURRENT_JOBS=2

# Pin to a specific model commit once you know a known-good one; "main" is the
# safe-to-ship default until then.
UNLIMITED_OCR_MODEL_REVISION=main
