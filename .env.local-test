# LOCAL TEST ONLY — used by docker-compose.local-test.yml to run the CPU app
# on a dev machine with no GPU. The prod env file is .env. See
# run-local-test.ps1 and DEPLOYMENT.md's "Local testing without a GPU"
# section. TS_AUTHKEY is intentionally omitted — the local-test compose file
# has no tailscale sidecar to authenticate.

# Same value as gpu-ocr-service/.env.local-test's GPU_OCR_SHARED_SECRET
GPU_OCR_SHARED_SECRET=51732f88d782e7fa74c646a884b35a4d7aa1c43bfea919e22e6c0227c89b4e13

# gpu-ocr-service's local-test stack, reached directly on the host instead of
# over a tailnet (its own tailscale sidecar publishes 11610 on this host)
GPU_OCR_BASE_URL=http://host.docker.internal:11610
OLLAMA_BASE_URL=http://host.docker.internal:11610/ollama

GPU_OCR_CONNECT_TIMEOUT_SECONDS=10
GPU_OCR_POLL_INTERVAL_SECONDS=3

# CPU mode — ~93s/page, serialized at GPU_OCR_MAX_CONCURRENT_JOBS=1, so a
# multi-page PDF needs much more than the prod 600s to clear the queue
GPU_OCR_POLL_TIMEOUT_SECONDS=180

# How many pages this CPU service submits to the GPU service at once. Kept
# at 1 — this box has almost no memory headroom once a single ~14GB worker
# is loaded, so even a second concurrent page attempt risks an OOM-kill.
OCR_JOB_CONCURRENCY=1

OCR_LOCAL_ENGINE=false

# AuthNexus SSO — same tenant as prod; DEV_MODE=true bypasses it entirely
AUTH_AUTHORITY=https://auth.rokkalabs.com
PROJECT_ID=386950421362507779
ORG_ID=383329441725546499
CLIENT_ID=386950458121453571

DEV_MODE=false
DEV_SECRET=
